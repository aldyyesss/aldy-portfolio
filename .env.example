# Server-only Supabase configuration. Never use NEXT_PUBLIC_ for secret keys.
SUPABASE_PROJECT_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Legacy service_role key can be used instead of SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_PASSWORD=
# Optional database URL for a connection pooler instead of the direct host.
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=aldy-portfolio
ALDY_ADMIN_EMAIL=Aldyradya2@gmail.com
# Optional initial password for setup. Otherwise setup generates one in the ignored .env.
ALDY_ADMIN_INITIAL_PASSWORD=
FRONTEND_URL=http://localhost:3000
PORT=3300
